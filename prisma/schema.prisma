generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               Int                 @id @default(autoincrement())
  name             String
  email            String              @unique
  passwordHash     String
role             String            @default("STUDENT") // ADMIN | INSTRUCTOR | STUDENT
  gender           String? // MALE | FEMALE (accounts created before this field may be null)
  sessionVersion   Int               @default(0) // bumped on every login; revokes older sessions
  createdAt        DateTime            @default(now())
  emailVerifiedAt  DateTime?
  enrollments      Enrollment[]
  attempts         Attempt[]
  verifications    EmailVerification[]
  ownedSubjects    Subject[]
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subject {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  // The instructor who owns this subject. Exams inherit ownership through
  // their subject, so a subject is the single tenancy boundary. Nullable so
  // `prisma db push` never needs --accept-data-loss on a populated table;
  // rows without an owner are only visible to the admin (delete-only) and are
  // backfilled by scripts/backfill-subject-owners.ts.
  ownerId     Int?
  // 6-char student enrollment code (globally unique, uppercase). Students
  // enroll themselves by entering it on the dashboard. Nullable so nothing
  // needs re-seeding on schema push; scripts/backfill-join-tokens.ts fills
  // tokens for subjects created before this field existed.
  joinToken   String?            @unique
  createdAt   DateTime     @default(now())
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  exams       Exam[]
  enrollments Enrollment[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  subjectId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model Exam {
  id                Int        @id @default(autoincrement())
  subjectId         Int
  title             String
  description       String?
  durationMinutes   Int        @default(30)
  pointsPerQuestion Int        @default(1) // default for questions without a section
  published         Boolean    @default(false)
  showResult        Boolean    @default(false)
  randomize         Boolean    @default(true)
  requireCamera     Boolean    @default(false)
  scheduledDate     DateTime?
  createdAt         DateTime   @default(now())
  subject           Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sections          ExamSection[]
  questions         Question[]
  attempts          Attempt[]
}

model ExamSection {
  id                Int        @id @default(autoincrement())
  examId            Int
  name              String
  details           String?
  pointsPerQuestion Int        @default(1)
  order             Int        @default(0)
  exam              Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions         Question[]

  @@index([examId])
}

model Question {
  id            Int          @id @default(autoincrement())
  examId        Int
  sectionId     Int?
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // A | B | C | D
  order         Int          @default(0)
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  section       ExamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  answers       Answer[]
}

model Attempt {
  id               Int       @id @default(autoincrement())
  examId           Int
  userId           Int
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  score            Int?
  total            Int?
  ip               String?
  userAgent        String?
  focusLosses      Int       @default(0)
  focusLossAt      DateTime?
  totalFocusLossMs Int       @default(0)
  maxBlurMs        Int       @default(0)
  cameraEnabled    Boolean   @default(false)
  snapshotCount    Int       @default(0)
  exam             Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers          Answer[]
  snapshots        AttemptSnapshot[]

  @@unique([examId, userId])
}

model AttemptSnapshot {
  id         Int      @id @default(autoincrement())
  attemptId  Int
  path       String
  capturedAt DateTime @default(now())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, capturedAt])
}

model Answer {
  id             Int      @id @default(autoincrement())
  attemptId      Int
  questionId     Int
  selectedOption String?
  isCorrect      Boolean  @default(false)
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
